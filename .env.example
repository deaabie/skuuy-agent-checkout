# PayPal Sandbox API Credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id_here

# PayPal Environment ('sandbox' or 'production')
PAYPAL_ENV=sandbox

# Base URL of this checkout service
PUBLIC_BASE_URL=https://checkout.skuuy.com
